# Fibonacci sequence via recursion.

import "std"

main: fib

fib: 
    "the recursion scheme has an extra parameter that is not"
    "necessary for computing Fibonacci values, we fix it at 1"
    comp fib_extra_param piggyfront_1

fib_extra_param:
    "apply the recursive scheme on step to recurse, base case, and"
    "is_base test, which will be checked just for pr_R"
    "if case is base, the answer is the same 0 or 1 as pr_R"
    rec fib_step pr_R is_zero_or_one_R

# fib step receives info coded as <<param.induct_val>.induct_seq>>

fib_step:
    "add the head and the next-to-head of the sequence of values" 
    "so far, which is to be found in pr_R"
    comp add pair pr_LR pr_LRR

pr_LRR: 
    "pr_L on pr_RR" 
    comp pr_L pr_RR

is_zero_or_one_R:
    "is the relevant part of input below 2, that is, base case?"
    comp neg comp gt pair pr_R k_1

