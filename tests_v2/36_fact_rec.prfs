# Factorial via recursion.
# Able to construct an encoding of the sequence of values, 
# hundreds of digits long, e.g. beyond 13!. Delay starts
# to be noticeable around 20!

import "std"

main: fact

fact: 
    "recursion has an extra parameter that is not necessary"
    "for computing the factorial, we fix it at 1"
    comp fact_extra_param piggyfront_1

fact_extra_param:
    "recursive function on step to recurse, base case, is_base test"
    "the is_base test will be checked just for pr_R"
    rec fact_step k_1 is_zero

# fact step receives info coded as <<param.induct_val>.induct_seq>>

fact_step:
    "find the factorial of pr_RL multiplying it by the factorial"
    "of its anterior, to be found in the head pr_L of the sequence"
    "of values of factorials up to that anterior, which is pr_R"
    comp mul pair pr_RL pr_LR

is_zero:
    "is the relevant part of input zero, that is, base case?"
    comp neg comp gt pair id k_0

