# Factorial with primitive recursion
# Import-based version.
# Recursion is able to construct an encoding of the sequence of
# values, hundreds of digits long, e.g. for 13!. Not sure where 
# it stops providing values within reasonable time.

import "std"

main: fact

fact: 
    "recursion has an extra parameter that is not necessary"
    "for computing the factorial, we fix it at 1"
    comp fact_extra_param piggyfront_1

fact_extra_param:
    "recursive function on step to recurse, base case, is_base test"
    "the is_base test will be checked just for pr_R"
    rec fact_step k_1 is_zero

fact_step:
    "factorial of anterior of pr_R is pr_L of the sequence of values"
    comp mul pair pr_LR pr_LRR

pr_LRR: 
    "pr_L on pr_RR" 
    comp pr_L pr_RR

is_zero:
    "is the relevant part of input zero, that is, base case?"
    comp neg comp gt pair id k_0

